<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>PCCleaner</RootNamespace>
    <AssemblyName>UltimatePCCleaner</AssemblyName>

    <Version>2.0.0</Version>
    <Product>Ultimate PC Cleaner</Product>
    <AssemblyTitle>Ultimate PC Cleaner</AssemblyTitle>
    <Description>Safely clean temporary files, manage startup apps and optimize Windows.</Description>
    <Copyright>Copyright © 2026</Copyright>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <NeutralLanguage>en</NeutralLanguage>

    <!-- Runs as the current user; admin-only features offer "Restart as administrator" when needed. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Only ship the app's UI languages from the framework/packages (smaller self-contained publish). -->
    <SatelliteResourceLanguages>en;sr-Latn;ru;de;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PCCleaner.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="System.Management" Version="10.0.14" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.14" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.DependencyInjection" Version="4.3.0" />
  </ItemGroup>

</Project>
