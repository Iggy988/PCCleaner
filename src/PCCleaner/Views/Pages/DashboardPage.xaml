<Page
    x:Class="PCCleaner.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PCCleaner.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PCCleaner.ViewModels"
    Title="Dashboard"
    d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <StackPanel Margin="0,0,0,24">

        <!--  Hero  -->
        <Border
            Padding="28,24"
            Background="{StaticResource BrandGradient}"
            CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="14"
                        Foreground="#DDFFFFFF"
                        Text="{Binding Greeting}" />
                    <TextBlock
                        Margin="0,2,0,10"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding MachineName}" />
                    <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            Foreground="#DDFFFFFF"
                            Symbol="Desktop24" />
                        <TextBlock Foreground="#EEFFFFFF" Text="{Binding OsName}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            Foreground="#DDFFFFFF"
                            Symbol="DeveloperBoard24" />
                        <TextBlock Foreground="#EEFFFFFF" Text="{Binding CpuName}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            Foreground="#DDFFFFFF"
                            Symbol="Clock24" />
                        <TextBlock Foreground="#EEFFFFFF">
                            <Run Text="Up for" />
                            <Run Text="{Binding UptimeText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock
                        MaxWidth="460"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        FontSize="13"
                        Foreground="White"
                        Text="{Binding BoostStatus}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid
                    Grid.Column="1"
                    Margin="24,0,8,0"
                    VerticalAlignment="Center">
                    <Button
                        Command="{Binding BoostCommand}"
                        Style="{StaticResource BoostButton}"
                        ToolTip="Clean selected junk, flush DNS and free RAM">
                        <Grid>
                            <StackPanel Visibility="{Binding IsBoosting, Converter={StaticResource InverseBoolToVisibility}}">
                                <ui:SymbolIcon
                                    HorizontalAlignment="Center"
                                    FontSize="38"
                                    Foreground="{StaticResource BrandBrush}"
                                    Symbol="Rocket24" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource BrandBrush}"
                                    Text="BOOST" />
                            </StackPanel>
                            <ui:ProgressRing
                                Width="48"
                                Height="48"
                                Foreground="{StaticResource BrandBrush}"
                                IsIndeterminate="True"
                                Visibility="{Binding IsBoosting, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!--  Live gauges  -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="System status" />
        <UniformGrid Columns="3">
            <Border Margin="0,0,6,0" Style="{StaticResource Card}">
                <StackPanel HorizontalAlignment="Center">
                    <controls:ArcGauge Label="CPU" Value="{Binding CpuPercent}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource CaptionText}"
                        Text="Processor load"
                        TextAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Margin="3,0,3,0" Style="{StaticResource Card}">
                <StackPanel HorizontalAlignment="Center">
                    <controls:ArcGauge Label="Memory" Value="{Binding RamPercent}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource CaptionText}"
                        Text="{Binding RamText}"
                        TextAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Margin="6,0,0,0" Style="{StaticResource Card}">
                <StackPanel HorizontalAlignment="Center">
                    <controls:ArcGauge Label="{Binding DiskLabel}" Value="{Binding DiskPercent}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource CaptionText}"
                        Text="{Binding DiskText}"
                        TextAlignment="Center" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!--  Junk + stats  -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="Cleanup" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Margin="0,0,6,0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="56"
                        Height="56"
                        Margin="0,0,16,0"
                        VerticalAlignment="Top">
                        <Border
                            Width="56"
                            Height="56"
                            Style="{StaticResource IconTile}" />
                        <ui:SymbolIcon
                            FontSize="28"
                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            Symbol="Broom24" />
                    </Grid>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource CaptionText}" Text="Junk found in selected categories" />
                        <Grid>
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding Cleaner.SelectedBytes, Converter={StaticResource Bytes}}"
                                Visibility="{Binding Cleaner.HasScanned, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock
                                Margin="0,6,0,6"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Not scanned yet"
                                Visibility="{Binding Cleaner.HasScanned, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                        <ProgressBar
                            Margin="0,4,0,8"
                            IsIndeterminate="True"
                            Visibility="{Binding Cleaner.IsScanning, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                            <ui:Button
                                Appearance="Primary"
                                Command="{Binding ScanJunkCommand}"
                                Content="Scan now"
                                Icon="{ui:SymbolIcon Search24}" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Command="{Binding OpenCleanerCommand}"
                                Content="Review in Cleaner"
                                Icon="{ui:SymbolIcon ChevronRight24}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Margin="6,0,0,0"
                Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Text="Total space freed" />
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding TotalFreedText}" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="Last cleaned" />
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding LastCleanedText}" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</Page>
