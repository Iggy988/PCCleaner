<Page
    x:Class="PCCleaner.Views.Pages.TempCleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PCCleaner.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:PCCleaner.Services.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PCCleaner.ViewModels"
    Title="{loc:Tr Nav_TempFiles}"
    d:DataContext="{d:DesignInstance vm:TempCleanerViewModel}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <StackPanel Margin="0,0,0,24">
        <TextBlock
            Margin="2,0,0,12"
            Style="{StaticResource CaptionText}"
            Text="{loc:Tr Temp_Intro}" />

        <!--  Toolbar  -->
        <Grid Margin="0,0,0,12" controls:Motion.Entrance="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <ui:SymbolIcon
                    Margin="0,0,10,0"
                    FontSize="20"
                    Foreground="{StaticResource BrandBrush}"
                    Symbol="DataUsage24" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="14"
                    Text="{Binding Summary}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button
                    controls:Motion.Interactive="True"
                    Command="{Binding ScanCommand}"
                    Content="{loc:Tr Common_Scan}"
                    Icon="{ui:SymbolIcon Search24}" />
                <ui:Button
                    Margin="8,0,0,0"
                    controls:Motion.Interactive="True"
                    Appearance="Primary"
                    Command="{Binding CleanCommand}"
                    Content="{loc:Tr Temp_CleanSelected}"
                    Icon="{ui:SymbolIcon Delete24}" />
            </StackPanel>
        </Grid>

        <!--  Locations  -->
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TempLocationViewModel}">
                    <ContentControl
                        Margin="0,0,0,10"
                        controls:Motion.Delay="80"
                        controls:Motion.Entrance="True"
                        Padding="16,14"
                        Style="{StaticResource ElevatedCard}">
                        <Grid x:Name="Row">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox
                                MinWidth="0"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="{Binding Title}"
                                IsChecked="{Binding IsChecked}"
                                IsEnabled="{Binding IsAvailable}" />

                            <Grid
                                Grid.Column="1"
                                Width="40"
                                Height="40"
                                Margin="4,0,14,0"
                                VerticalAlignment="Top">
                                <Border
                                    Width="40"
                                    Height="40"
                                    Style="{StaticResource IconTile}" />
                                <ui:SymbolIcon
                                    FontSize="21"
                                    Foreground="{StaticResource BrandBrush}"
                                    Symbol="{Binding Icon}" />
                            </Grid>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource TitleText}" Text="{Binding Title}" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Description}" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{Binding DisplayPath}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding DisplayPath}" />

                                <!--  Prefetch caution  -->
                                <Border
                                    Margin="0,8,0,0"
                                    Padding="10,8"
                                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                    CornerRadius="8"
                                    Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon
                                            Margin="0,1,8,0"
                                            VerticalAlignment="Top"
                                            FontSize="14"
                                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                            Symbol="Info24" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource CaptionText}"
                                            Text="{Binding Note}" />
                                    </Grid>
                                </Border>

                                <!--  Why administrator rights are needed  -->
                                <Border
                                    Margin="0,8,0,0"
                                    Padding="10,8"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{Binding NeedsElevation, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ui:SymbolIcon
                                            Margin="0,1,8,0"
                                            VerticalAlignment="Top"
                                            FontSize="16"
                                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                            Symbol="ShieldError24" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource CaptionText}"
                                            Text="{loc:Tr Temp_AdminReason}" />
                                        <ui:Button
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            Command="{Binding DataContext.RestartAsAdministratorCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            Content="{loc:Tr Common_RestartAsAdmin}"
                                            Icon="{ui:SymbolIcon ShieldCheckmark24}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel
                                Grid.Column="3"
                                MinWidth="150"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <ui:ProgressRing
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        IsIndeterminate="True"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock
                                        x:Name="StatusLabel"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding StatusText}" />
                                </StackPanel>
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource CaptionText}"
                                    Text="{Binding DetailText}"
                                    TextAlignment="Right"
                                    Visibility="{Binding DetailText, Converter={StaticResource NullToVisibility}}" />
                                <ui:Button
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Right"
                                    Appearance="Transparent"
                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}"
                                    Icon="{ui:SymbolIcon FolderOpen24}"
                                    ToolTip="{loc:Tr Temp_OpenFolder}" />
                            </StackPanel>
                        </Grid>
                    </ContentControl>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tone}" Value="Accent">
                            <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource BrandBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tone}" Value="Success">
                            <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tone}" Value="Caution">
                            <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tone}" Value="Critical">
                            <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                            <Setter TargetName="Row" Property="Opacity" Value="0.8" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  Live progress  -->
        <ContentControl
            Margin="0,4,0,0"
            Style="{StaticResource ElevatedCard}"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{Binding ProgressText}" />
                    <ProgressBar
                        Height="6"
                        Margin="0,8,0,6"
                        IsIndeterminate="{Binding IsScanning}"
                        Maximum="100"
                        Value="{Binding Progress}" />
                    <TextBlock
                        Style="{StaticResource CaptionText}"
                        Text="{Binding ProgressCounts}"
                        Visibility="{Binding ProgressCounts, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource CaptionText}"
                        Text="{loc:Tr Temp_Reclaimed}" />
                    <controls:AnimatedNumber
                        HorizontalAlignment="Right"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{StaticResource BrandBrush}"
                        Format="Bytes"
                        Value="{Binding FreedBytes}" />
                </StackPanel>
                <ui:Button
                    Grid.Column="2"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding CancelCommand}"
                    Content="{loc:Tr Common_Cancel}"
                    Icon="{ui:SymbolIcon Dismiss24}" />
            </Grid>
        </ContentControl>

        <!--  Result (accurate: partial success is reported as such)  -->
        <StackPanel Visibility="{Binding ShowResult, Converter={StaticResource BoolToVisibility}}">
            <ContentControl
                Margin="0,4,0,8"
                controls:Motion.Entrance="True"
                Style="{StaticResource ElevatedCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon
                        x:Name="ResultIcon"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        FontSize="34">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultSeverity}" Value="Warning">
                                        <Setter Property="Symbol" Value="Warning24" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ResultSeverity}" Value="Error">
                                        <Setter Property="Symbol" Value="ErrorCircle24" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Bottom"
                                FontSize="20"
                                FontWeight="Bold"
                                Text="{Binding ResultTitle}" />
                            <controls:AnimatedNumber
                                Margin="12,0,0,0"
                                VerticalAlignment="Bottom"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="{StaticResource BrandBrush}"
                                Format="Bytes"
                                Value="{Binding FreedBytes}" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource CaptionText}"
                            Text="{Binding ResultMessage}" />
                    </StackPanel>
                </Grid>
            </ContentControl>

            <ui:CardExpander
                Header="{loc:Tr Temp_SkippedHeader}"
                Icon="{ui:SymbolIcon DocumentDismiss24}"
                Visibility="{Binding HasSkippedItems, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource CaptionText}"
                        Text="{loc:Tr Temp_SkippedHint}" />
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SkippedItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SkippedItemViewModel}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            FontFamily="Cascadia Mono, Consolas"
                                            FontSize="11.5"
                                            Text="{Binding Path}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding Path}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                            Style="{StaticResource CaptionText}"
                                            Text="{Binding ReasonText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </ui:CardExpander>
        </StackPanel>

        <!--  How it works / safety  -->
        <ui:CardExpander
            Margin="0,12,0,0"
            Header="{loc:Tr Temp_SafetyHeader}"
            Icon="{ui:SymbolIcon ShieldCheckmark24}">
            <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Tr Temp_SafetyBody}" />
        </ui:CardExpander>
    </StackPanel>
</Page>
