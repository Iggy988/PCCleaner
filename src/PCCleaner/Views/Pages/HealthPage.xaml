<Page
    x:Class="PCCleaner.Views.Pages.HealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:PCCleaner.Services.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="clr-namespace:PCCleaner.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PCCleaner.ViewModels"
    Title="{loc:Tr Nav_Health}"
    d:DataContext="{d:DesignInstance vm:HealthViewModel}"
    ScrollViewer.CanContentScroll="False"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Grid Margin="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="180" />
        </Grid.RowDefinitions>

        <ui:InfoBar
            Title="{loc:Tr Health_AdminTitle}"
            Margin="0,0,0,10"
            IsClosable="False"
            IsOpen="{Binding IsAdministrator, Converter={StaticResource InverseBool}, Mode=OneTime}"
            Message="{loc:Tr Health_AdminMessage}"
            Severity="Warning" />

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Tools}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type services:HealthTool}">
                    <Border
                        Margin="0,0,8,8"
                        Padding="14"
                        Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Width="38"
                                Height="38"
                                Margin="0,0,12,0"
                                VerticalAlignment="Top">
                                <Border Style="{StaticResource IconTile}" />
                                <ui:SymbolIcon
                                    FontSize="20"
                                    Foreground="{StaticResource BrandBrush}"
                                    Symbol="{Binding Icon}" />
                            </Grid>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource TitleText}" Text="{Binding Name}" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Description}" />
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Margin="0,0,4,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Symbol="Timer24" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding Duration}" />
                                </StackPanel>
                            </StackPanel>
                            <ui:Button
                                Grid.Column="2"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding DataContext.RunToolCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                Content="{loc:Tr Common_Run}"
                                Icon="{ui:SymbolIcon Play24}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  Console toolbar  -->
        <Grid Grid.Row="2" Margin="0,8,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:ProgressRing
                Width="18"
                Height="18"
                Margin="0,0,10,0"
                IsIndeterminate="True"
                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{Binding StatusText}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ui:Button
                    Appearance="Danger"
                    Command="{Binding CancelCommand}"
                    Content="{loc:Tr Common_Cancel}"
                    Icon="{ui:SymbolIcon Stop24}"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button
                    Margin="6,0,0,0"
                    Appearance="Transparent"
                    Command="{Binding CopyOutputCommand}"
                    Icon="{ui:SymbolIcon Copy24}"
                    ToolTip="{loc:Tr Health_Copy}" />
                <ui:Button
                    Margin="2,0,0,0"
                    Appearance="Transparent"
                    Command="{Binding ClearOutputCommand}"
                    Icon="{ui:SymbolIcon Delete24}"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"
                    ToolTip="{loc:Tr Health_Clear}" />
            </StackPanel>
        </Grid>

        <!--  Live console  -->
        <Border
            Grid.Row="3"
            Margin="0,0,8,0"
            Background="#FF0C0C14"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <TextBox
                x:Name="OutputBox"
                Padding="14,10"
                Background="Transparent"
                BorderThickness="0"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="12.5"
                Foreground="#FFB8F5C8"
                HorizontalScrollBarVisibility="Auto"
                IsReadOnly="True"
                Text="{Binding Output, Mode=OneWay}"
                TextChanged="OnOutputChanged"
                TextWrapping="NoWrap"
                VerticalScrollBarVisibility="Auto" />
        </Border>
    </Grid>
</Page>
