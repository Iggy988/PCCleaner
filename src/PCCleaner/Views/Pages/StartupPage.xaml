<Page
    x:Class="PCCleaner.Views.Pages.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:PCCleaner.Services.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PCCleaner.ViewModels"
    Title="{loc:Tr Nav_Startup}"
    d:DataContext="{d:DesignInstance vm:StartupViewModel}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <StackPanel Margin="0,0,0,24">
        <TextBlock
            Margin="2,0,0,12"
            Style="{StaticResource CaptionText}"
            Text="{loc:Tr Startup_Intro}" />

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="{loc:Tr Startup_Search}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                Grid.Column="1"
                Margin="16,0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionText}"
                Text="{Binding Summary}" />
            <ui:Button
                Grid.Column="2"
                Command="{Binding LoadCommand}"
                Content="{loc:Tr Common_Refresh}"
                Icon="{ui:SymbolIcon ArrowClockwise24}" />
        </Grid>

        <ui:InfoBar
            Title="{loc:Tr Startup_ReadOnlyTitle}"
            Margin="0,0,0,10"
            IsClosable="True"
            IsOpen="{Binding ShowAdminNotice, Mode=OneWay}"
            Message="{loc:Tr Startup_ReadOnlyMessage}"
            Severity="Warning" />

        <ui:ProgressRing
            Margin="0,40"
            HorizontalAlignment="Center"
            IsIndeterminate="True"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock
            Margin="0,40"
            HorizontalAlignment="Center"
            Style="{StaticResource CaptionText}"
            Text="{loc:Tr Startup_Empty}"
            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

        <ItemsControl ItemsSource="{Binding View}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:StartupItemViewModel}">
                    <Border x:Name="Row" Style="{StaticResource RowCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid
                                Width="38"
                                Height="38"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center">
                                <Border Style="{StaticResource IconTile}" Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ui:SymbolIcon
                                    FontSize="20"
                                    Foreground="{StaticResource BrandBrush}"
                                    Symbol="WindowApps24"
                                    Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVisibility}}" />
                                <Image
                                    Width="32"
                                    Height="32"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Source="{Binding Icon}"
                                    Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource TitleText}" Text="{Binding Name}" />
                                <TextBlock Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                    <Run Text="{Binding Publisher, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding Location, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    FontFamily="Consolas"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    FontSize="11"
                                    Text="{Binding Command}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Command}" />
                            </StackPanel>

                            <ui:Button
                                Grid.Column="2"
                                Margin="12,0"
                                Appearance="Transparent"
                                Command="{Binding OpenLocationCommand}"
                                Icon="{ui:SymbolIcon FolderOpen24}"
                                IsEnabled="{Binding CanOpenLocation}"
                                ToolTip="{loc:Tr Startup_OpenLocation}" />

                            <ui:ToggleSwitch
                                Grid.Column="3"
                                MinWidth="110"
                                IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                IsEnabled="{Binding CanToggle}"
                                OffContent="{loc:Tr Common_Disabled}"
                                OnContent="{loc:Tr Common_Enabled}" />
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                            <Setter TargetName="Row" Property="Opacity" Value="0.7" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
