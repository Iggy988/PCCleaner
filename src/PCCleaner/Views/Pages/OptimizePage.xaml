<Page
    x:Class="PCCleaner.Views.Pages.OptimizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PCCleaner.ViewModels"
    Title="Optimize"
    d:DataContext="{d:DesignInstance vm:OptimizeViewModel}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <StackPanel Margin="0,0,0,24">
        <ui:InfoBar
            Title="Safe and reversible"
            IsClosable="False"
            IsOpen="True"
            Message="Every switch can be turned back off to restore your original setting. When enabled in Settings, a System Restore point is created before the first change."
            Severity="Informational" />

        <TextBlock Style="{StaticResource SectionHeader}" Text="Performance tweaks" />
        <ItemsControl ItemsSource="{Binding Tweaks}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TweakItemViewModel}">
                    <ui:CardControl Margin="0,0,0,6" IsEnabled="{Binding IsAvailable}">
                        <ui:CardControl.Icon>
                            <ui:SymbolIcon FontSize="24" Symbol="{Binding Icon}" />
                        </ui:CardControl.Icon>
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource TitleText}" Text="{Binding Name}" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Description}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:ProgressRing
                                Width="18"
                                Height="18"
                                Margin="0,0,12,0"
                                IsIndeterminate="True"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                            <ui:ToggleSwitch
                                IsChecked="{Binding IsApplied, Mode=TwoWay}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                OffContent="Off"
                                OnContent="On" />
                        </StackPanel>
                    </ui:CardControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Quick actions" />

        <ui:CardControl Margin="0,0,0,6">
            <ui:CardControl.Icon>
                <ui:SymbolIcon FontSize="24" Symbol="Globe24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleText}" Text="Flush DNS cache" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="Clears stored website addresses. Fixes sites that fail to load after network or DNS changes." />
                    <TextBlock
                        Margin="0,2,0,0"
                        Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                        Style="{StaticResource CaptionText}"
                        Text="{Binding DnsResult}"
                        Visibility="{Binding DnsResult, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ProgressRing
                    Width="18"
                    Height="18"
                    Margin="0,0,12,0"
                    IsIndeterminate="True"
                    Visibility="{Binding IsFlushingDns, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button
                    MinWidth="96"
                    Command="{Binding FlushDnsCommand}"
                    Content="Run"
                    Icon="{ui:SymbolIcon Play24}" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,6">
            <ui:CardControl.Icon>
                <ui:SymbolIcon FontSize="24" Symbol="DeveloperBoard24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleText}" Text="Free up RAM" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="Trims apps' unused memory and clears the standby cache. Handy right before starting a game or heavy app." />
                    <TextBlock
                        Margin="0,2,0,0"
                        Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                        Style="{StaticResource CaptionText}"
                        Text="{Binding RamResult}"
                        Visibility="{Binding RamResult, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ProgressRing
                    Width="18"
                    Height="18"
                    Margin="0,0,12,0"
                    IsIndeterminate="True"
                    Visibility="{Binding IsFreeingRam, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button
                    MinWidth="96"
                    Command="{Binding FreeRamCommand}"
                    Content="Run"
                    Icon="{ui:SymbolIcon Play24}" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,6" IsEnabled="{Binding IsAdministrator}">
            <ui:CardControl.Icon>
                <ui:SymbolIcon FontSize="24" Symbol="ShieldCheckmark24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleText}" Text="Create a restore point" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="Saves a System Restore snapshot you can roll back to from Windows Recovery. Requires administrator rights." />
                    <TextBlock
                        Margin="0,2,0,0"
                        Style="{StaticResource CaptionText}"
                        Text="{Binding RestorePointResult}"
                        Visibility="{Binding RestorePointResult, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ProgressRing
                    Width="18"
                    Height="18"
                    Margin="0,0,12,0"
                    IsIndeterminate="True"
                    Visibility="{Binding IsCreatingRestorePoint, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button
                    MinWidth="96"
                    Command="{Binding CreateRestorePointCommand}"
                    Content="Create"
                    Icon="{ui:SymbolIcon Add24}"
                    IsEnabled="{Binding IsCreatingRestorePoint, Converter={StaticResource InverseBool}}" />
            </StackPanel>
        </ui:CardControl>
    </StackPanel>
</Page>
