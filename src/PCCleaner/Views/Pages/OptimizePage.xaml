<Page
    x:Class="PCCleaner.Views.Pages.OptimizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:PCCleaner.Services.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PCCleaner.ViewModels"
    Title="{loc:Tr Nav_Optimize}"
    d:DataContext="{d:DesignInstance vm:OptimizeViewModel}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <StackPanel Margin="0,0,0,24">
        <ui:InfoBar
            Title="{loc:Tr Optimize_SafeTitle}"
            IsClosable="False"
            IsOpen="True"
            Message="{loc:Tr Optimize_SafeMessage}"
            Severity="Informational" />

        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Tr Optimize_Tweaks}" />
        <ItemsControl ItemsSource="{Binding Tweaks}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TweakItemViewModel}">
                    <ui:CardControl Margin="0,0,0,6" IsEnabled="{Binding IsAvailable}">
                        <ui:CardControl.Icon>
                            <ui:SymbolIcon FontSize="24" Symbol="{Binding Icon}" />
                        </ui:CardControl.Icon>
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource TitleText}" Text="{Binding Name}" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Description}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:ProgressRing
                                Width="18"
                                Height="18"
                                Margin="0,0,12,0"
                                IsIndeterminate="True"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                            <ui:ToggleSwitch
                                IsChecked="{Binding IsApplied, Mode=TwoWay}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                OffContent="{loc:Tr Common_Off}"
                                OnContent="{loc:Tr Common_On}" />
                        </StackPanel>
                    </ui:CardControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Tr Optimize_QuickActions}" />

        <ui:CardControl Margin="0,0,0,6">
            <ui:CardControl.Icon>
                <ui:SymbolIcon FontSize="24" Symbol="Globe24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleText}" Text="{loc:Tr Optimize_DnsTitle}" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Tr Optimize_DnsDesc}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                        Style="{StaticResource CaptionText}"
                        Text="{Binding DnsResult}"
                        Visibility="{Binding DnsResult, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ProgressRing
                    Width="18"
                    Height="18"
                    Margin="0,0,12,0"
                    IsIndeterminate="True"
                    Visibility="{Binding IsFlushingDns, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button
                    MinWidth="96"
                    Command="{Binding FlushDnsCommand}"
                    Content="{loc:Tr Common_Run}"
                    Icon="{ui:SymbolIcon Play24}" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,6">
            <ui:CardControl.Icon>
                <ui:SymbolIcon FontSize="24" Symbol="DeveloperBoard24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleText}" Text="{loc:Tr Optimize_RamName}" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Tr Optimize_RamDesc}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                        Style="{StaticResource CaptionText}"
                        Text="{Binding RamResult}"
                        Visibility="{Binding RamResult, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ProgressRing
                    Width="18"
                    Height="18"
                    Margin="0,0,12,0"
                    IsIndeterminate="True"
                    Visibility="{Binding IsFreeingRam, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button
                    MinWidth="96"
                    Command="{Binding FreeRamCommand}"
                    Content="{loc:Tr Common_Run}"
                    Icon="{ui:SymbolIcon Play24}" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,6" IsEnabled="{Binding IsAdministrator}">
            <ui:CardControl.Icon>
                <ui:SymbolIcon FontSize="24" Symbol="ShieldCheckmark24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleText}" Text="{loc:Tr Optimize_RestoreTitle}" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Tr Optimize_RestoreDesc}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Style="{StaticResource CaptionText}"
                        Text="{Binding RestorePointResult}"
                        Visibility="{Binding RestorePointResult, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ProgressRing
                    Width="18"
                    Height="18"
                    Margin="0,0,12,0"
                    IsIndeterminate="True"
                    Visibility="{Binding IsCreatingRestorePoint, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button
                    MinWidth="96"
                    Command="{Binding CreateRestorePointCommand}"
                    Content="{loc:Tr Common_Create}"
                    Icon="{ui:SymbolIcon Add24}"
                    IsEnabled="{Binding IsCreatingRestorePoint, Converter={StaticResource InverseBool}}" />
            </StackPanel>
        </ui:CardControl>
    </StackPanel>
</Page>
