<Page
    x:Class="PCCleaner.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PCCleaner.ViewModels"
    Title="Settings"
    d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <StackPanel Margin="0,0,0,24">
        <TextBlock
            Margin="2,0,0,8"
            Style="{StaticResource SectionHeader}"
            Text="Appearance" />
        <ui:CardControl Margin="0,0,0,6">
            <ui:CardControl.Icon>
                <ui:SymbolIcon FontSize="24" Symbol="Color24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleText}" Text="App theme" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="Choose light, dark, or follow your Windows setting." />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox
                MinWidth="200"
                DisplayMemberPath="Label"
                ItemsSource="{Binding ThemeOptions}"
                SelectedItem="{Binding SelectedTheme}" />
        </ui:CardControl>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Cleaning" />
        <ui:CardControl Margin="0,0,0,6">
            <ui:CardControl.Icon>
                <ui:SymbolIcon FontSize="24" Symbol="Clock24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleText}" Text="Skip temp files newer than 24 hours" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="Recommended. Recent temp files may still be used by installers or running apps." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding SkipRecentTempFiles}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,6">
            <ui:CardControl.Icon>
                <ui:SymbolIcon FontSize="24" Symbol="CheckboxChecked24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleText}" Text="Remember my selections" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="Keep the categories you check or uncheck in the Cleaner for next time." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding RememberSelections}" />
        </ui:CardControl>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Safety" />
        <ui:CardControl Margin="0,0,0,6">
            <ui:CardControl.Icon>
                <ui:SymbolIcon FontSize="24" Symbol="ShieldCheckmark24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleText}" Text="Create a restore point before optimizing" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="Makes a System Restore point before the first tweak in each session (administrator only)." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding CreateRestorePoint}" />
        </ui:CardControl>

        <TextBlock Style="{StaticResource SectionHeader}" Text="About" />
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image
                    Width="48"
                    Height="48"
                    Margin="0,0,16,0"
                    Source="pack://application:,,,/Assets/app.png" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="16" FontWeight="SemiBold">
                        <Run Text="PC Cleaner" />
                        <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Version, Mode=OneWay, StringFormat=v{0}}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource CaptionText}">
                        <Run Text="Settings and logs:" />
                        <Run Text="{Binding DataFolder, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button
                        Command="{Binding OpenDataFolderCommand}"
                        Content="Open folder"
                        Icon="{ui:SymbolIcon FolderOpen24}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Command="{Binding OpenLogsCommand}"
                        Content="View logs"
                        Icon="{ui:SymbolIcon DocumentBulletList24}" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</Page>
