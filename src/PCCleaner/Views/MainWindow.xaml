<ui:FluentWindow
    x:Class="PCCleaner.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:PCCleaner.Services.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:PCCleaner.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PCCleaner.ViewModels"
    Title="{Binding Title}"
    Width="1240"
    Height="840"
    MinWidth="980"
    MinHeight="640"
    d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="TitleBar"
            Title="{Binding Title}"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!--  Limited mode: explain what needs admin and offer elevation (dismissible)  -->
        <Border
            Grid.Row="1"
            Margin="12,0,12,6"
            Padding="16,10"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon
                    Margin="0,0,12,0"
                    FontSize="20"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Symbol="ShieldError24" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="{loc:Tr Main_LimitedTitle}" />
                    <Run Text="{loc:Tr Main_LimitedMessage}" />
                </TextBlock>
                <ui:Button
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    Appearance="Primary"
                    Command="{Binding RestartAsAdministratorCommand}"
                    Content="{loc:Tr Common_RestartAsAdmin}"
                    Icon="{ui:SymbolIcon ShieldCheckmark24}" />
                <ui:Button
                    Grid.Column="3"
                    Margin="6,0,0,0"
                    Appearance="Transparent"
                    Command="{Binding DismissAdminBannerCommand}"
                    Icon="{ui:SymbolIcon Dismiss24}"
                    ToolTip="{loc:Tr Common_Dismiss}" />
            </Grid>
        </Border>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="2"
            Padding="42,0,42,0"
            FrameMargin="0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            OpenPaneLength="240"
            PaneDisplayMode="Left"
            TitleBar="{Binding ElementName=TitleBar}"
            Transition="FadeInWithSlide">
            <ui:NavigationView.Header>
                <!--  Bound to the current page's localized Title (see MainWindow.xaml.cs), so it follows language changes  -->
                <TextBlock
                    x:Name="PageHeader"
                    Margin="42,24,42,16"
                    FontSize="28"
                    FontWeight="DemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </ui:NavigationView.Header>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="{loc:Tr Nav_Dashboard}"
                    Icon="{ui:SymbolIcon Home24}"
                    TargetPageType="{x:Type pages:DashboardPage}" />
                <ui:NavigationViewItem
                    Content="{loc:Tr Nav_TempFiles}"
                    Icon="{ui:SymbolIcon DocumentBulletList24}"
                    TargetPageType="{x:Type pages:TempCleanerPage}" />
                <ui:NavigationViewItem
                    Content="{loc:Tr Nav_Cleaner}"
                    Icon="{ui:SymbolIcon Broom24}"
                    TargetPageType="{x:Type pages:CleanerPage}" />
                <ui:NavigationViewItem
                    Content="{loc:Tr Nav_Startup}"
                    Icon="{ui:SymbolIcon Apps24}"
                    TargetPageType="{x:Type pages:StartupPage}" />
                <ui:NavigationViewItem
                    Content="{loc:Tr Nav_Security}"
                    Icon="{ui:SymbolIcon Shield24}"
                    TargetPageType="{x:Type pages:SecurityPage}" />
                <ui:NavigationViewItem
                    Content="{loc:Tr Nav_Optimize}"
                    Icon="{ui:SymbolIcon Rocket24}"
                    TargetPageType="{x:Type pages:OptimizePage}" />
                <ui:NavigationViewItem
                    Content="{loc:Tr Nav_Health}"
                    Icon="{ui:SymbolIcon HeartPulse24}"
                    TargetPageType="{x:Type pages:HealthPage}" />
                <ui:NavigationViewItem
                    Content="{loc:Tr Nav_System}"
                    Icon="{ui:SymbolIcon Desktop24}"
                    TargetPageType="{x:Type pages:SystemPage}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="{loc:Tr Nav_Help}"
                    Icon="{ui:SymbolIcon BookQuestionMark24}"
                    TargetPageType="{x:Type pages:HelpPage}" />
                <ui:NavigationViewItem
                    Content="{loc:Tr Nav_Settings}"
                    Icon="{ui:SymbolIcon Settings24}"
                    TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <ui:ContentDialogHost x:Name="RootContentDialogHost" Grid.Row="0" Grid.RowSpan="3" />
    </Grid>
</ui:FluentWindow>
