<ui:FluentWindow
    x:Class="PCCleaner.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:PCCleaner.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PCCleaner.ViewModels"
    Title="{Binding Title}"
    Width="1200"
    Height="800"
    MinWidth="960"
    MinHeight="620"
    d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="TitleBar"
            Title="{Binding Title}"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Border
            Grid.Row="1"
            Margin="12,0,12,6"
            Padding="16,10"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{Binding IsAdministrator, Converter={StaticResource InverseBoolToVisibility}, Mode=OneTime}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon
                    Margin="0,0,12,0"
                    FontSize="20"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Symbol="Warning24" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="Limited mode." />
                    <Run Text="PC Cleaner isn't running as administrator, so system folders, services and health tools are unavailable." />
                </TextBlock>
                <ui:Button
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    Appearance="Primary"
                    Command="{Binding RestartAsAdministratorCommand}"
                    Content="Restart as administrator"
                    Icon="{ui:SymbolIcon ShieldCheckmark24}" />
            </Grid>
        </Border>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="2"
            Padding="42,0,42,0"
            BreadcrumbBar="{Binding ElementName=BreadcrumbBar}"
            FrameMargin="0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            OpenPaneLength="230"
            PaneDisplayMode="Left"
            TitleBar="{Binding ElementName=TitleBar}"
            Transition="FadeInWithSlide">
            <ui:NavigationView.Header>
                <ui:BreadcrumbBar
                    x:Name="BreadcrumbBar"
                    Margin="42,24,42,16"
                    FontSize="28"
                    FontWeight="DemiBold" />
            </ui:NavigationView.Header>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="Dashboard"
                    Icon="{ui:SymbolIcon Home24}"
                    TargetPageType="{x:Type pages:DashboardPage}" />
                <ui:NavigationViewItem
                    Content="Cleaner"
                    Icon="{ui:SymbolIcon Broom24}"
                    TargetPageType="{x:Type pages:CleanerPage}" />
                <ui:NavigationViewItem
                    Content="Startup apps"
                    Icon="{ui:SymbolIcon Apps24}"
                    TargetPageType="{x:Type pages:StartupPage}" />
                <ui:NavigationViewItem
                    Content="Optimize"
                    Icon="{ui:SymbolIcon Rocket24}"
                    TargetPageType="{x:Type pages:OptimizePage}" />
                <ui:NavigationViewItem
                    Content="Health"
                    Icon="{ui:SymbolIcon HeartPulse24}"
                    TargetPageType="{x:Type pages:HealthPage}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="Settings"
                    Icon="{ui:SymbolIcon Settings24}"
                    TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <ui:ContentDialogHost x:Name="RootContentDialogHost" Grid.Row="0" Grid.RowSpan="3" />
    </Grid>
</ui:FluentWindow>
